# Copy this file to ".env" and fill in your key. Never commit the real .env file.
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# --- Optional settings (defaults shown) ---
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_MODELS=llama-3.1-8b-instant            # extra models to offer in the sidebar, comma separated
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# EMBEDDING_BACKEND=huggingface               # use "hashing" for an offline, download-free demo mode
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=200
# TOP_K=4
# SCORE_THRESHOLD=0.25
# TEMPERATURE=0.2
# MAX_FILE_SIZE_MB=20
